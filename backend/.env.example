# Copy to .env and fill in. Never commit the real .env.

# --- Supabase ---------------------------------------------------------------
# Dashboard -> Project Settings -> Data API
SUPABASE_URL=https://your-project-ref.supabase.co
# Dashboard -> Project Settings -> API Keys -> service_role.
# This key bypasses Row Level Security. Server-side only — it must never be
# exposed to the browser or prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=documents

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=sk-your-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Must match the vector(N) width in supabase/migrations/0001_init.sql.
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- CORS -------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call this API.
# Add your deployed Vercel URL here once the frontend is live.
ALLOWED_ORIGINS=http://localhost:3000

# --- Ingestion (optional; sensible defaults shown) ---------------------------
MAX_UPLOAD_BYTES=20971520
MAX_PAGES=500
CHUNK_TARGET_TOKENS=600
CHUNK_OVERLAP_TOKENS=90
EMBEDDING_BATCH_SIZE=96

# --- Retrieval (optional) ----------------------------------------------------
RETRIEVAL_TOP_K=5
# Cosine-similarity floor: the off-topic guardrail. Chunks scoring below this
# never reach the model, so an unrelated question is refused without spending
# an LLM call.
#
# Scores do NOT span 0-1. With text-embedding-3-small, genuinely relevant
# passages score ~0.25-0.55 and unrelated questions ~0.05-0.20. Raising this
# to something that sounds strict (0.5, 0.7) makes the app refuse everything,
# including good questions. Tune in steps of 0.02 and re-test.
RETRIEVAL_MIN_SIMILARITY=0.22
